# 複製成 .env 再填（cp env.example .env）。.env 已經在 .gitignore 裡，不會進 git。
# 用內建語音（engine = say）做影片，這個檔可以完全不填。

# ── 付費配音（用哪個才填哪個）──
BREEZE_API_KEY=
BREEZE_VOICE_ID=
MINIMAX_API_KEY=
GEMINI_API_KEY=

# ── 片頭／片尾音效（tools/jingle.py，選配）──
ELEVENLABS_API_KEY=

# ── 上傳 YouTube（選配）──
# 放 OAuth 檔案的資料夾（youtube-client.json、youtube-token.json；這兩個是憑證，不要放進 repo）
YOUTUBE_OAUTH_DIR=~/.config/daily-video

# ── Telegram 通知（選配）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
